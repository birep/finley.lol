# Cloudflare API Configuration
# Copy this file to .cloudflare.env and fill in your values

# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Token needs: Account → Pages → Edit, Zone → DNS → Edit

CLOUDFLARE_API_TOKEN=your-api-token-here

# Get your Account ID from: https://dash.cloudflare.com (bottom left)
# Or run: curl -s https://api.cloudflare.com/client/v4/accounts -H "Authorization: Bearer YOUR_TOKEN"

CLOUDFLARE_ACCOUNT_ID=your-account-id-here
